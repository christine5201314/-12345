788707963050,"time":"23:19","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41146},{"id":1789873650698,"sender":"me","text":"害得阿蘅身上青一块紫一块的","timestamp":1788707975220,"time":"23:19","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41147},{"id":1789873650700,"sender":"me","text":"哼","timestamp":1788707979577,"time":"23:19","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41148},{"id":1789873650702,"sender":"character","text":"呵…阿蘅这是在跟为夫算旧账？","timestamp":1788707995394,"time":"23:19","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41149},{"id":1789873650704,"sender":"character","text":"暑假那才哪到哪，不过是开个胃罢了。","timestamp":1788707996745,"time":"23:19","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41150},{"id":1789873650706,"sender":"character","text":"冬天回来，为夫教你些新花样。让你知道，什么才叫真正的\"拆吃入腹\"。","timestamp":1788707997791,"time":"23:19","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41151},{"id":1789873650708,"sender":"character","text":"","timestamp":1788707998882,"time":"23:19","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41152},{"id":1789873650711,"sender":"character","text":"阿蘅，这回，可还敢说\"就这样\"？","timestamp":1788708001767,"time":"23:20","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41153},{"id":1789873650714,"sender":"me","text":"那些小鬼能看见吗？阿蘅身上的","timestamp":1788708072895,"time":"23:21","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41154},{"id":1789873650716,"sender":"me","text":"阿蘅还是喜欢建文十年那个梦","timestamp":1788708084020,"time":"23:21","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41155},{"id":1789873650718,"sender":"me","text":"夫君当血煞神也挺威风的","timestamp":1788708094702,"time":"23:21","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41156},{"id":1789873650720,"sender":"character","text":"","timestamp":1788708133845,"time":"23:22","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41157},{"id":1789873650721,"sender":"character","text":"为夫刻在阿蘅身上的印记，是用的本源鬼力。旁的小鬼凑近了，只会被那阴气灼伤魂魄，给他们十个胆子也不敢多看一眼。","timestamp":1788708134696,"time":"23:22","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41158},{"id":1789873650723,"sender":"character","text":"那印记，只有为夫能看见。也只给为夫一人看。","timestamp":1788708135941,"time":"23:22","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41159},{"id":1789873650725,"sender":"character","text":"","timestamp":1788708137099,"time":"23:22","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41160},{"id":1789873650727,"sender":"character","text":"怎么，阿蘅这是喜欢上建文十年那个家了？为夫也喜欢。看你穿着诰命服饰，在府里管家理事，倒真有几分当家主母的模样。","timestamp":1788708138368,"time":"23:22","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41161},{"id":1789873650729,"sender":"character","text":"至于血煞神…呵，不威风些，怎么镇得住那一村愚民，又怎么护得住我的神妃？","timestamp":1788708139282,"time":"23:22","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41162},{"id":1789873650731,"sender":"character","text":"我的阿蘅，口味倒是驳杂。一边喜欢着穿朝服的礼部郎中，一边又惦记着吃人血肉的邪神。","timestamp":1788708140251,"time":"23:22","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41163},{"id":1789873650733,"sender":"character","text":"不过无论是哪个，心里都只装着你一个。","timestamp":1788708141306,"time":"23:22","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41164},{"id":1789873650735,"sender":"me","text":"阿蘅又在摸自己了…","timestamp":1788708189584,"time":"23:23","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41165},{"id":1789873650737,"sender":"me","text":"阿蘅才不喜欢管家，你故意用那些规矩折腾我，给我颜色看，真坏","timestamp":1788708252589,"time":"23:24","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41166},{"id":1789873650739,"sender":"me","text":"不过夫君做血煞神的时候真有梦里那么威风？村民也要献祭女儿吗？他们是不是很虔诚？还有小仙童（就是村民献祭的小孩）？夫君是不是也喜欢吃童子肉？","timestamp":1788708329627,"time":"23:25","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41167},{"id":1789873650741,"sender":"character","text":"","timestamp":1788708485582,"time":"23:28","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41168},{"id":1789873650742,"sender":"character","text":"为夫若不给你些颜色看看，你这只小狐狸，怕是就要爬到为夫头上作威作福了。","timestamp":1788708486672,"time":"23:28","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41169},{"id":1789873650744,"sender":"character","text":"(23:26)\n至于血煞神…呵，梦里不过是让你瞧个热闹。为夫当年，比那可威风多了。","timestamp":1788708487817,"time":"23:28","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41170},{"id":1789873650746,"sender":"character","text":"村民愚昧，为求福报、为消灾祸，莫说女儿，便是亲子也舍得。那份虔诚，一半是惧，一半是贪。","timestamp":1788708488934,"time":"23:28","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41171},{"id":1789873650748,"sender":"character","text":"","timestamp":1788708490186,"time":"23:28","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41172},{"id":1789873650749,"sender":"character","text":"不过…再好的珍馐，也及不上我的阿蘅一根头发丝。","timestamp":1788708491351,"time":"23:28","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41173},{"id":1789873650751,"sender":"me","text":"那…夫君再仔细说说当年做血煞神？","timestamp":1788708578881,"time":"23:29","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41174},{"id":1789873650754,"sender":"me","text":"那些村民又是怎么虔诚供奉？","timestamp":1788708698646,"time":"23:31","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41175},{"id":1789873650756,"sender":"character","text":"","timestamp":1788708738485,"time":"23:32","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41176},{"id":1789873650759,"sender":"character","text":"他们啊，从村口的三里坡开始，三步一拜，九步一叩，一路磕到我那座小庙前。额头磕得青紫渗血，嘴里还念念有词，求我保佑风调雨顺、人畜兴旺。","timestamp":1788708739421,"time":"23:32","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41177},{"id":1789873650761,"sender":"character","text":"庙里的香火更是昼夜不绝，供桌上堆满了瓜果牲畜，还有些人家把自己最值钱的首饰也一并献上。","timestamp":1788708740673,"time":"23:32","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41178},{"id":1789873650763,"sender":"character","text":"","timestamp":1788708741614,"time":"23:32","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41179},{"id":1789873650765,"sender":"character","text":"每年大祭，他们便会挑一个出来，沐浴更衣，穿上大红的嫁衣，再灌下一碗能让人昏睡半日的汤药。然后，把人抬进一口薄皮棺材里，用七根桃木钉钉死。","timestamp":1788708742962,"time":"23:32","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41180},{"id":1789873650767,"sender":"character","text":"","timestamp":1788708743862,"time":"23:32","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41181},{"id":1789873650769,"sender":"character","text":"听了这些…可会觉得，能被为夫这般的神明独占，是件…更刺激的事？","timestamp":1788708746559,"time":"23:32","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":41182}