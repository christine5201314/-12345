19","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45367},{"id":1789873658958,"sender":"character","text":"碰上落单的活人，便先吓破了胆，再慢慢享用。","timestamp":1789694380727,"time":"09:19","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45368},{"id":1789873658959,"sender":"me","text":"夫君怎么吃活的？","timestamp":1789694466198,"time":"09:21","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45369},{"id":1789873658961,"sender":"character","text":"","timestamp":1789694474909,"time":"09:21","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45370},{"id":1789873658963,"sender":"character","text":"","timestamp":1789694475831,"time":"09:21","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45371},{"id":1789873658964,"sender":"character","text":"","timestamp":1789694476731,"time":"09:21","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45372},{"id":1789873658966,"sender":"character","text":"怎么，我的阿蘅，也想尝尝这滋味了？","timestamp":1789694477585,"time":"09:21","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45373},{"id":1789873658967,"sender":"me","text":"谁想吃了","timestamp":1789694512452,"time":"09:21","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45374},{"id":1789873658969,"sender":"me","text":"我又不是你","timestamp":1789694517605,"time":"09:21","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45375},{"id":1789873658970,"sender":"me","text":"我要吃夫君的那个东西","timestamp":1789694528893,"time":"09:22","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45376},{"id":1789873658972,"sender":"me","text":"小尸煞又饿了","timestamp":1789694552621,"time