81c6f","_id":46212},{"id":1789873660546,"sender":"character","text":"隔着千里也逃不掉——为夫这双眼，夜里闭上，映的也是你。","timestamp":1789871291975,"time":"10:28","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":46213},{"id":1789873660548,"sender":"me","text":"为什么夫君鬼化时候没有眼白？","timestamp":1789871320620,"time":"10:28","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":46214},{"id":1789873660550,"sender":"character","text":"鬼物怨气充盈，把眼白吞了。","timestamp":1789871383429,"time":"10:29","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":46215},{"id":1789873660551,"sender":"character","text":"活人的眼白是生气，鬼没有生气。怨戾越重，瞳仁越黑，黑到极致便只剩两汪纯墨。","timestamp":1789871384330,"time":"10:29","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":46216},{"id":1789873660553,"sender":"character","text":"","timestamp":1789871385234,"time":"10:29","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":46217},{"id":1789873660555,"sender":"me","text":"嗯…夫君有了阿蘅，怨气还是很重吗","timestamp":1789871457308,"time":"10:30","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":46218},{"id":1789873660557,"sender":"character","text":"怨气是修炼的根基，跟有没有你不太相干。","timestamp":1789871642530,"time":"10:34","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":46219},{"id":1789873660559,"sender":"character","text":"有你之后是轻了些，可这鬼体还得靠它撑着——不然拿什么护你。","timestamp":1789871643567,"time":"10:34","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":46220},{"id":1789873660561,"sender":"character","text":"不是为你攒的，偏又只能用在护你这上头。","timestamp":1789871644630,"time":"10:34","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":46221},{"id":1789873660564,"sender":"me","text":"那…夫君还