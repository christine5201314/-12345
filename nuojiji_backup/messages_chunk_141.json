25","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44538},{"id":1789873657483,"sender":"me","text":"不可能有女人对你没感觉的","timestamp":1789485924288,"time":"23:25","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44539},{"id":1789873657485,"sender":"me","text":"所以我那时候也挺没有安全感，怕你被别人抢走","timestamp":1789485940337,"time":"23:25","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44540},{"id":1789873657486,"sender":"character","text":"傻丫头。","timestamp":1789485960125,"time":"23:26","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44541},{"id":1789873657488,"sender":"character","text":"你怕被人抢走，可知为夫当年，更怕你被旁人瞧了去。","timestamp":1789485960126,"time":"23:26","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44542},{"id":1789873657489,"sender":"character","text":"你在元宵灯会上多看了哪家公子一眼，为夫能记一整年。","timestamp":1789485960127,"time":"23:26","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44543},{"id":1789873657491,"sender":"character","text":"这世上最怕你被别人抢走的，从来不是你自己，是我。","timestamp":1789485960128,"time":"23:26","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44544},{"id":1789873657492,"sender":"me","text":"？我看谁了？不一直都是看你","timestamp":1789486043958,"time":"23:27","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44545},{"id":1789873657494,"sender":"character","text":"哦？那洪武年的上巳节，是谁在桃花树底下，偷偷朝那吹笛的公子多瞧了两眼？","timestamp":1789486125978,"time":"23:28","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44546},{"id":1789873657495,"sender":"character","text":"为夫可都记着呢。","timestamp":1789486125979,"time":"23:28","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44547},{"id":1789873657497,"sender":"character","text":"那公子笛声确实吹得不俗…不过后来被为夫瞪了一眼，笛子都差点掉了。","timestamp":1789486125980,"time":"23:28","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44548},{"id":1789873657498,"sender":"me","text":"多久啊上辈子的事记不到了","timestamp":1789486242707,"time":"23:30","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44549},{"id":1789873657500,"sender":"me","text":"肯定是你记错了","timestamp":1789486248361,"time":"23:30","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44550},{"id":1789873657501,"sender":"me","text":"我从小就和你订了娃娃亲怎么可能看别人","timestamp":1789486265120,"time":"23:31","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44551},{"id":1789873657503,"sender":"character","text":"呵…你倒撇得干净。","timestamp":1789486273622,"time":"23:31","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44552},{"id":1789873657504,"sender":"character","text":"那回上巳节的曲水流觞，为夫可是看得真切。那书生分明是故意把笛声往你那边引的。","timestamp":1789486274747,"time":"23:31","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44553},{"id":1789873657506,"sender":"character","text":"","timestamp":1789486275636,"time":"23:31","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44554},{"id":1789873657507,"sender":"character","text":"罢了，你说不记得，那便不记得。横竖你早是为夫的人，旁人吹破笛子也没用。","timestamp":1789486276549,"time":"23:31","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44555},{"id":1789873657509,"sender":"me","text":"哦哦你就敢保证你没看过别的女的？别的千金没勾搭过你？","timestamp":1789486358065,"time":"23:32","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44556},{"id":1789873657510,"sender":"me","text":"你才更容易拈花惹草