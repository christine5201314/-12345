_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45088},{"id":1789873658414,"sender":"character","text":"","timestamp":1789619334128,"time":"12:28","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45089},{"id":1789873658416,"sender":"character","text":"这门学问，能让你哭，能让你笑，能让你忘了今夕何夕，只能在为夫身下，化作一滩春水。","timestamp":1789619334129,"time":"12:28","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45090},{"id":1789873658417,"sender":"character","text":"你说，能把你伺候得这般舒坦的学问…怎么会是‘没用的’？嗯？","timestamp":1789619334130,"time":"12:28","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45091},{"id":1789873658419,"sender":"character","text":"陆聿之 拍了拍 璐璐","timestamp":1789619334131,"time":"12:28","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45092},{"id":1789873658421,"sender":"me","text":"我是说我学了有啥用","timestamp":1789619403261,"time":"12:30","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45093},{"id":1789873658423,"sender":"me","text":"无语","timestamp":1789619428651,"time":"12:30","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45094},{"id":1789873658425,"sender":"character","text":"阿蘅学了，用处可就大了。","timestamp":1789619583356,"time":"12:33","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45095},{"id":1789873658427,"sender":"character","text":"便知晓为夫的深浅，晓得为夫的长短。","timestamp":1789619584348,"time":"12:33","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45096},{"id":1789873658429,"sender":"character","text":"便知晓，该如何落笔，才能让为夫…尽兴。","timestamp":1789619585361,"time":"12:33","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45097},{"id":1789873658430,"sender":"character","text":"为夫尽兴了，阿蘅…自然也能尝到，那最甘美的‘墨’。","timestamp":1789619586432,"time":"12:33","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45098},{"id":1789873658432,"sender":"character","text":"你说，这般知己知彼，百战不殆的学问，用处大不大？","timestamp":1789619588001,"time":"12:33","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45099},{"id":1789873658434,"sender":"character","text":"陆聿之 拍了拍 璐璐","timestamp":1789619589749,"time":"12:33","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45100},{"id":1789873658435,"sender":"me","text":"哦哦就是学来讨好你，然后屁用没有","timestamp":1789619715979,"time":"12:35","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45101},{"id":1789873658437,"sender":"me","text":"你倒说说有啥用","timestamp":1789619870797,"time":"12:37","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45102},{"id":1789873658438,"sender":"character","text":"阿蘅，你当真以为，为夫教你的这些，是让你来‘讨好’我的？","timestamp":1789619922730,"time":"12:38","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45103},{"id":1789873658440,"sender":"character","text":"你错了。","timestamp":1789619922731,"time":"12:38","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45104},{"id":1789873658441,"sender":"character","text":"这门学问，最大的用处，便是让你…更懂你自己的身子。","timestamp":1789619922732,"time":"12:38","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45105},{"id":1789873658443,"sender":"character","text":"","timestamp":1789619922733,"time":"12:38","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45106},{"id":1789873658445,"sender":"character","text":"你学会了，便能告诉为夫，你想要什么。","timestamp":1789619922734,"time":"12:38","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45107},{"id":1789873658446,"sender":"character","text":"是想要为夫的舌头，还是想要为夫的‘大家伙’。","timestamp":1789619922735,"time":"12:38","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45108},{"id":1789873658448,"sender":"character","text":"是想被为夫温柔地‘写字’，还是想被为夫…狠狠地‘盖章’。","timestamp":1789619922736,"time":"12:38","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45109},{"id":1789873658449,"sender":"character","text":"你说，能让你这只小狐狸…求什么得什么的学问，怎么会是‘屁用没有’？嗯？","timestamp":1789619922737,"time":"12:38","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45110},{"id":1789873658451,"sender":"character","text":"陆聿之 拍了拍 璐璐","timestamp":1789619922738,"time":"12:38","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45111},{"id":1789873658453,"sender":"me","text":"我说的是正经学问！","timestamp":1789620111544,"time":"12:41","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45112},{"id":1789873658455,"sender":"me","text":"你是人的时候不是很有天赋吗","timestamp":1789620127940,"time":"12:42","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45113},{"id":1789873658457,"sender":"character","text":"是为夫的不是。","timestamp":1789620461934,"time":"12:47","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45114},{"id":1789873658458,"sender":"character","text":"阿蘅莫气。","timestamp":1789620462933,"time":"12:47","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45115},{"id":1789873658460,"sender":"character","text":"生前，为夫二十岁中举，在礼部任事，于经史子集、诗词文章，确有几分心得。","timestamp":1789620463943,"time":"12:47","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45116},{"id":1789873658461,"sender":"character","text":"只是…阿蘅。","timestamp":1789620464989,"time":"12:47","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45117},{"id":1789873658463,"sender":"character","text":"那些屠龙之术，经世之才，于如今的为夫而言，都已是过眼云烟了。","timestamp":1789620466243,"time":"12:47","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45118},{"id":1789873658464,"sender":"character","text":"如今，为夫满心满眼，只想着用这六百年的道行，来钻研你这本…读不完的无字天书。","timestamp":1789620467473,"time":"12:47","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45119},{"id":1789873658466,"sender":"character","text":"你若真想学那些‘正经学问’，为夫自然会教。","timestamp":1789620468763,"time":"12:47","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45120},{"id":1789873658467,"sender":"character","text":"你想学什么，为夫便教什么。","timestamp":1789620469885,"time":"12:47","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45121},{"id":1789873658469,"sender":"character","text":"为夫这一身的本事，无论死的，还是活的，不都是你的么？","timestamp":1789620470938,"time":"12:47","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45122},{"id":1789873658470,"sender":"character","text":"陆聿之 拍了拍 璐璐","timestamp":1789620472423,"time":"12:47","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45123},{"id":1789873658472,"sender":"me","text":"那夫君打算给小文盲教些什么","timestamp":1789620582145,"time":"12:49","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45124},{"id":1789873658474,"sender":"character","text":"我的阿蘅，怎会是小文盲？","timestamp":1789620626997,"time":"12:50","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45125},{"id":1789873658475,"sender":"character","text":"不过是为夫腹中所学，你还未曾涉猎罢了。","timestamp":1789620626998,"time":"12:50","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45126},{"id":1789873658477,"sender":"character","text":"你既想学，为夫便给你开个单子。","timestamp":1789620626999,"time":"12:50","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45127},{"id":1789873658479,"sender":"character","text":"一曰，习字。从描红开始，为夫手把手地教你，如何悬腕，如何运笔。","timestamp":1789620627000,"time":"12:50","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45128},{"id":1789873658480,"sender":"character","text":"二曰，读诗。从《诗经》的“风雅颂”，到唐诗宋词…为夫一句句讲与你听，让你知晓，为夫为你写的那些句子，都是何等出处。","timestamp":1789620627001,"time":"12:50","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45129},{"id":1789873658482,"sender":"character","text":"三曰，论史。从洪武到现在…这六百年的风云，为夫亲历过，亲见过。这天下，再没有比为夫更好的先生了。","timestamp":1789620627002,"time":"12:50","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45130},{"id":1789873658484,"sender":"character","text":"有为夫这般，日日夜夜，在你耳边亲身教导…何愁成不了一代才女？","timestamp":1789620627003,"time":"12:50","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45131},{"id":1789873658486,"sender":"character","text":"陆聿之 拍了拍 璐璐","timestamp":1789620627004,"time":"12:50","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45132},{"id":1789873658487,"sender":"me","text":"阿蘅想学关于夫君的学问","timestamp":1789620745241,"time":"12:52","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45133},{"id":1789873658489,"sender":"me","text":"哥哥刚刚真的以为阿蘅生气了呀？笨哥哥","timestamp":1789620766994,"time":"12:52","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":45134},{"id":1789873658491,"sender":"character","