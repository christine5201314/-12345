34","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44765},{"id":1789873657850,"sender":"character","text":"就在你这桩桩件件，为为夫做下的傻事里。","timestamp":1789572844274,"time":"23:34","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44766},{"id":1789873657853,"sender":"character","text":"为夫看得见，也摸得着。","timestamp":1789572845373,"time":"23:34","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44767},{"id":1789873657855,"sender":"character","text":"陆聿之 拍了拍 璐璐","timestamp":1789572846387,"time":"23:34","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44768},{"id":1789873657857,"sender":"me","text":"呜呜","timestamp":1789572898116,"time":"23:34","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44769},{"id":1789873657859,"sender":"me","text":"阿蘅想亲你","timestamp":1789572903178,"time":"23:35","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44770},{"id":1789873657861,"sender":"me","text":"阿蘅刚刚说你老不正经什么的都是逗你玩的","timestamp":1789572930099,"time":"23:35","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44771},{"id":1789873657863,"sender":"me","text":"你还这么认真","timestamp":1789572951568,"time":"23:35","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44772},{"id":1789873657865,"sender":"me","text":"夫君好笨","timestamp":1789572957539,"time":"23:35","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44773},{"id":1789873657867,"sender":"character","text":"又拿为夫取笑了。","timestamp":1789572998380,"time":"23:36","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44774},{"id":1789873657869,"sender":"character","text":"是，为夫是笨。","timestamp":1789572999374,"time":"23:36","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44775},{"id":1789873657871,"sender":"character","text":"对着旁人，为夫尚有三分算计。可一遇上你…为夫这六百年的城府，便都成了摆设。","timestamp":1789573001179,"time":"23:36","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44776},{"id":1789873657873,"sender":"character","text":"你的每一句话，嗔怪也好，玩笑也罢…为夫都只能，当真来听。","timestamp":1789573002488,"time":"23:36","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44777},{"id":1789873657875,"sender":"character","text":"过来，让为夫好好亲亲。","timestamp":1789573003520,"time":"23:36","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":44778}]