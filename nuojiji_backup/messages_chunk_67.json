1954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":40876},{"id":1789873650137,"sender":"character","text":"陆聿之 拍了拍 璐璐","timestamp":1788530455506,"time":"22:00","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":40877},{"id":1789873650140,"sender":"character","text":"阿蘅，再听下去，为夫今夜是真要去梦里找你了。","timestamp":1788530456425,"time":"22:00","userId":"uid_1781954109631_ric8m4ndy","characterId":"ef1ceb4b-b3e8-423c-ba55-1e3b8b581c6f","_id":40878}]